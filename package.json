{
  "name": "altaqaddum-company-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "preinstall": "node -e \"const fs=require('fs'); for (const file of ['package-lock.json','yarn.lock']) { try { fs.unlinkSync(file); } catch (_) {} } const agent=process.env.npm_config_user_agent || ''; if (!agent.startsWith('pnpm/')) { console.error('Use pnpm instead'); process.exit(1); }\"",
    "dev": "vite --config vite.config.js",
    "build": "vite build --config vite.config.js"
  },
  "dependencies": {
    "alpinejs": "^3.15.12",
    "axios": "^1.18.1"
  },
  "devDependencies": {
    "@esbuild/win32-x64": "0.27.3",
    "@rollup/rollup-win32-x64-msvc": "4.62.2",
    "@tailwindcss/forms": "^0.5.11",
    "autoprefixer": "^10.5.4",
    "laravel-vite-plugin": "^3.1.3",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "7.3.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@rollup/rollup-win32-x64-msvc",
      "@rolldown/binding-win32-x64-msvc"
    ]
  }
}